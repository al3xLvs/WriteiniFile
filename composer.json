{
    "name": "magicalex/write-ini-file",
    "type": "library",
    "description": "PHP library to create, read, update, add, remove and erase ini files",
    "keywords": [
        "config",
        "file",
        "ini",
        "parse_ini_file",
        "write",
        "write_ini_file"
    ],
    "homepage": "https://github.com/al3xLvs/WriteiniFile",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Magicalex",
            "email": "magicalex@mondedie.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/al3xLvs/WriteiniFile/issues",
        "source": "https://github.com/al3xLvs/WriteiniFile"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WriteiniFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WriteiniFile\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
